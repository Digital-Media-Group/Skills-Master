{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/skill.schema.json",
  "title": "Professional Skill Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "category",
    "name",
    "summary",
    "tags",
    "maintainers",
    "license",
    "locales",
    "compatibility",
    "capabilities",
    "riskLevel",
    "inputs",
    "outputs",
    "dependencies",
    "lastReviewed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["experimental", "stable", "deprecated", "archived"] },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/localizedText" },
    "summary": { "$ref": "#/$defs/localizedText" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "license": { "const": "Apache-2.0" },
    "locales": {
      "type": "array",
      "const": ["es", "en"]
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["universal", "claude-code", "openai-codex"] }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["files", "shell", "network", "browser", "database", "cloud", "credentials", "human-approval"] }
    },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "inputs": { "$ref": "#/$defs/nonEmptyLocalizedList" },
    "outputs": { "$ref": "#/$defs/nonEmptyLocalizedList" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "lastReviewed": { "type": "string", "format": "date" },
    "replacedBy": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "en"],
      "properties": {
        "es": { "type": "string", "minLength": 3 },
        "en": { "type": "string", "minLength": 3 }
      }
    },
    "nonEmptyLocalizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "en"],
      "properties": {
        "es": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      }
    }
  }
}
