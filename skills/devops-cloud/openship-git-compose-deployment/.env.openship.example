# Openship production environment template
# Keep real values in Openship, never commit .env or secrets.

# Application and auth (required)
NEXT_PUBLIC_APP_URL=https://your-domain.example
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
ALLOWED_SIGNUP_DOMAINS=example.com
TRUSTED_ORIGINS=https://your-domain.example
SUPERADMIN_EMAILS=admin@example.com
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=4000

# External PostgreSQL (required when the database is not a Compose service)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Backblaze B2 S3-compatible storage (optional, required for document storage)
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Telnyx SMS and verification (optional)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# Amazon SES SMTP (optional, required for transactional email)
AWS_SES_REGION=
AWS_SES_SMTP_HOST=
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Application
EMAIL_REPLY_TO=

# ERP integrations (optional)
WHMCS_API_URL=
WHMCS_IDENTIFIER=
WHMCS_SECRET=
DOLIBARR_API_URL=
DOLIBARR_API_KEY=

# SES webhook, timestamp authority and retention
SES_WEBHOOK_SECRET=
TSA_URL=https://freetsa.org/tsr
RETENTION_YEARS=6
